// Workload B for `branch_machine.of`: the *same code*, driven differently.
//
// Metric G-13. Real deployments collect a profile on one workload and run the
// binary on another, so a speedup measured with the profile applied to the very
// run it came from is the best case and not the interesting one. These variants
// change only `main` -- every function the profile describes is character for
// character the one it was collected from -- so the profile still matches by
// name and the only thing that has shifted is what the program actually does.
//
// Workload A feeds consecutive integers, so each state's transition arm is
// taken about 2% of the time. Workload B feeds multiples of 97 * 89 * 83,
// so every transition arm is taken *every single time*. The layout a
// profile from A produces -- rare arms sunk out of the way -- is then
// exactly backwards, which is the failure mode G-13 exists to size.
fn report(int state, int input) -> int {
    int acc = 0;
    int k = 0;
    while (k < 8) {
        acc = acc + state * k - input;
        k = k + 1;
    }
    return acc % 4;
}

fn step(int state, int input) -> int {
    if (state == 0) {
        if (input % 97 == 0) { return 1; }
        return 0;
    }
    if (state == 1) {
        if (input % 89 == 0) { return 2; }
        return 1;
    }
    if (state == 2) {
        if (input % 83 == 0) { return 0; }
        return 2;
    }
    return report(state, input);
}

fn main() -> int {
    int state = 0;
    int acc = 0;
    int i = 0;
    while (i < 130000000) {
        state = step(state, i * 716539);
        acc = acc + state;
        i = i + 1;
    }
    print_int(acc);
    return 0;
}
