// A tight counted loop: the shape instrumentation costs most on, because the
// loop body is short enough that one extra increment per block is a large
// share of it.
fn compute(int n) -> int {
    int total = 0;
    int i = 0;
    while (i < n) { total = total + i * 3 - 1; i = i + 1; }
    return total;
}
fn main() -> int {
    int acc = 0;
    int r = 0;
    while (r < 4000) { acc = acc + compute(200000); r = r + 1; }
    print_int(acc);
    return 0;
}
