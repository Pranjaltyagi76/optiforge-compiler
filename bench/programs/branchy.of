// Branch-heavy: two counters per conditional block, so the block count is high
// relative to the work done.
fn classify(int n) -> int {
    if (n % 7 == 0) { return 3; }
    if (n % 5 == 0) { return 2; }
    if (n % 3 == 0) { return 1; }
    return 0;
}
fn main() -> int {
    int acc = 0;
    int i = 0;
    while (i < 120000000) { acc = acc + classify(i); i = i + 1; }
    print_int(acc);
    return 0;
}
