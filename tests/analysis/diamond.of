// A single if/else. Hand-check: entry dominates all three arms; the merge
// block is dominated by entry, not by either arm; both arms have the merge
// block as their dominance frontier; no loops.
fn diamond(int n) -> int {
    int x = 0;
    if (n > 0) { x = 1; } else { x = 2; }
    return x;
}

fn main() -> int {
    return 0;
}
