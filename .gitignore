# Build output
build*/
cmake-build-*/
compile_commands.json
CMakeCache.txt
CMakeFiles/

# Compiler intermediates and binaries
*.o
*.a
*.s
*.obj
*.exe
*.out
a.out

# Binaries built in-tree. These MUST stay anchored with a leading slash: a bare
# "optiforge" pattern also matches the include/optiforge/ directory and would
# silently exclude every header in the project.
/optiforge
/optiforge.exe

# Profile data — machine- and workload-specific, regenerable.
# Test fixtures under tests/pgo/fixtures/ must be force-added: git add -f
*.prof

# Metrics: raw harness output is regenerable noise.
# Commit the raw data behind a published result by placing it in a published/ dir.
#
# The re-inclusion of the run directories is load-bearing and must not be
# tidied away. Git does not descend into an excluded directory, so a negation
# for a path *inside* one never gets the chance to match: without
# "!metrics/raw/*/" below, the published/ rules are dead text and every
# published result silently loses the samples behind it.
metrics/raw/**
!metrics/raw/.gitkeep
!metrics/raw/*/
!metrics/raw/*/published/
!metrics/raw/*/published/**

# Python tooling
__pycache__/
*.pyc
.venv/
venv/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
